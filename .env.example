# ==============================================================================
# FyNex Quant AI - Configurações de Conexão com a Binance
# ==============================================================================

# Suas credenciais de API da Binance (Obtenha em: Binance > Perfil > Gerenciamento de API)
# ATENÇÃO: NUNCA ative permissão de "Saque" (Withdrawal). Apenas "Leitura" e "Trading Spot".
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Ambiente das chaves acima (o robô deriva o ambiente do modo e recusa combinações incoerentes):
# true  -> Chaves da Binance Spot Testnet (https://testnet.binance.vision) - exigido pelo modo testnet
# false -> Chaves da Binance Spot Oficial (https://api.binance.com) - exigido pelo modo live
BINANCE_TESTNET=false

# Modo de Operação do Robô:
# paper   -> Simulação Quantitativa (dados de mercado reais, mas ordens virtuais sem risco)
# testnet -> Execução de ordens com saldo fictício na Testnet (exige BINANCE_TESTNET=true)
# live    -> EXECUÇÃO DE ORDENS REAIS (exige BINANCE_TESTNET=false; bloqueado no código até a Fase 4)
TRADING_MODE=paper

# Gestão de Risco Quantitativo:
# Quantidade em USDT alocada por ordem executada pela IA (mínimo recomendado: 15.00 USDT)
TRADE_AMOUNT_USDT=50.00

# Limites de Risco (o robô para de abrir novas posições ao atingi-los)
MAX_DAILY_LOSS_USDT=20.00
MAX_TRADES_PER_DAY=10
MAX_TRADE_AMOUNT_USDT=200.00

# Proteção na exchange: envia ordem OCO (Take Profit + Stop-Limit) logo após cada compra,
# mantendo a posição protegida mesmo com o robô desligado (modos testnet/live)
USE_EXCHANGE_OCO=true

# Kill-switch: crie um arquivo chamado STOP na pasta do projeto para bloquear novas entradas.
